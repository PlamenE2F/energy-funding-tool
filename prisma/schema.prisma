// VoltMatch Database Schema
// All configurable rate values stored in database tables, not hardcoded.
// Supports multi-jurisdictional expansion (ON, BC, QC, AB, UK, AU).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Configuration Tables (Section 6 of Rate Classification Framework)
// ---------------------------------------------------------------------------

/// Jurisdiction-level settings (e.g., Ontario, British Columbia)
model JurisdictionConfig {
  jurisdictionId       String   @id @map("jurisdiction_id") @db.VarChar(10)
  jurisdictionName     String   @map("jurisdiction_name")
  country              String   @db.VarChar(5)
  currency             String   @db.VarChar(5)
  areaUnit             String   @map("area_unit") @db.VarChar(10)
  energyUnit           String   @map("energy_unit") @db.VarChar(10)
  gasUnit              String   @map("gas_unit") @db.VarChar(10)
  taxRate              Decimal  @map("tax_rate")
  rebateName           String?  @map("rebate_name")
  rebateRate           Decimal? @map("rebate_rate")
  rebateEligibleClasses Json?   @map("rebate_eligible_classes")
  effectiveDate        DateTime @map("effective_date") @db.Date
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  // Emission factors (EUI Brief Section 8, Step 1)
  scope2AverageFactor        Decimal? @map("scope2_average_factor")
  scope2AverageFactorYear    Int?     @map("scope2_average_factor_year")
  sourceSiteRatioElectricity Decimal? @map("source_site_ratio_electricity")
  sourceSiteRatioFuel        Decimal? @map("source_site_ratio_fuel")
  benchmarkCostRateElectric  Decimal? @map("benchmark_cost_rate_electric")
  benchmarkCostRateGas       Decimal? @map("benchmark_cost_rate_gas")

  // Carbon pricing (structural — null for Ontario)
  carbonPricePerTonne        Decimal? @map("carbon_price_per_tonne")
  carbonPriceEffectiveDate   DateTime? @map("carbon_price_effective_date") @db.Date
  carbonPriceSource          String?  @map("carbon_price_source")

  rateClasses RateClassConfig[]
  touPeriods  TouPeriodConfig[]

  @@map("jurisdiction_config")
}

/// Rate class definitions per jurisdiction
model RateClassConfig {
  id                   Int      @id @default(autoincrement())
  jurisdictionId       String   @map("jurisdiction_id") @db.VarChar(10)
  rateClassId          String   @map("rate_class_id")
  rateClassName        String   @map("rate_class_name")
  peakDemandMinKw      Decimal? @map("peak_demand_min_kw")
  peakDemandMaxKw      Decimal? @map("peak_demand_max_kw")
  annualKwhMin         Int?     @map("annual_kwh_min")
  annualKwhMax         Int?     @map("annual_kwh_max")
  hasDemandCharges     Boolean  @default(false) @map("has_demand_charges")
  hasTemporalPricing   Boolean  @default(false) @map("has_temporal_pricing")
  hasSeparateGa        Boolean  @default(false) @map("has_separate_ga")
  defaultEffectiveRate Decimal  @map("default_effective_rate")
  defaultEnergyRate    Decimal  @map("default_energy_rate")
  demandChargeRate     Decimal? @map("demand_charge_rate")
  effectiveDate        DateTime @map("effective_date") @db.Date
  sourceReference      String?  @map("source_reference")

  jurisdiction JurisdictionConfig @relation(fields: [jurisdictionId], references: [jurisdictionId])

  @@unique([jurisdictionId, rateClassId])
  @@map("rate_class_config")
}

/// TOU period definitions (time-of-use periods with seasonal rates)
model TouPeriodConfig {
  id             Int      @id @default(autoincrement())
  jurisdictionId String   @map("jurisdiction_id") @db.VarChar(10)
  rateClassId    String   @map("rate_class_id")
  season         String   @db.VarChar(20)
  seasonStart    String?  @map("season_start") @db.VarChar(20)
  seasonEnd      String?  @map("season_end") @db.VarChar(20)
  periodName     String   @map("period_name") @db.VarChar(30)
  weekdayHours   Json?    @map("weekday_hours")
  weekendHours   Json?    @map("weekend_hours")
  ratePerKwh     Decimal  @map("rate_per_kwh")
  effectiveDate  DateTime @map("effective_date") @db.Date

  jurisdiction JurisdictionConfig @relation(fields: [jurisdictionId], references: [jurisdictionId])

  @@map("tou_period_config")
}

// ---------------------------------------------------------------------------
// EUI & Emissions Configuration Tables
// ---------------------------------------------------------------------------

/// Building type benchmark config (16 canonical types)
model BuildingTypeConfig {
  id                       Int      @id @default(autoincrement())
  buildingTypeId           String   @unique @map("building_type_id")
  buildingTypeName         String   @map("building_type_name")
  benchmarkSource          String?  @map("benchmark_source")
  benchmarkEuiGjM2         Decimal? @map("benchmark_eui_gj_m2")
  benchmarkEuiKwhSqft      Decimal? @map("benchmark_eui_kwh_sqft")
  electricityFraction      Decimal  @map("electricity_fraction")
  benchmarkClassification  String   @map("benchmark_classification") @db.VarChar(10)
  energyStarEligible       Boolean  @default(false) @map("energy_star_eligible")
  benchmarkCaveatText      String?  @map("benchmark_caveat_text")
  loadFactor               Decimal? @map("load_factor")

  // LED measure config per building type
  ledLightingSharePct      Decimal? @map("led_lighting_share_pct")
  ledCostMidpointPerSqft   Decimal? @map("led_cost_midpoint_per_sqft")
  ledCostUpperPerSqft      Decimal? @map("led_cost_upper_per_sqft")
  ledMeasureApplicable     Boolean  @default(true) @map("led_measure_applicable")
  ledMeasureNote           String?  @map("led_measure_note")

  // HVAC measure config per building type
  hvacElectricPct          Decimal? @map("hvac_electric_pct")
  hvacGasPct               Decimal? @map("hvac_gas_pct")
  hvacMeasureApplicable    Boolean  @default(true) @map("hvac_measure_applicable")
  hvacMeasureNote          String?  @map("hvac_measure_note")

  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("building_type_config")
}

/// Fuel type config with emission factors (ECCC V3.0)
model FuelTypeConfig {
  id                    Int      @id @default(autoincrement())
  fuelTypeId            String   @unique @map("fuel_type_id")
  fuelTypeName          String   @map("fuel_type_name")
  conversionFactorKwh   Decimal  @map("conversion_factor_kwh")
  unit                  String   @db.VarChar(10)
  emissionFactorCo2     Decimal  @map("emission_factor_co2")
  emissionFactorCh4     Decimal  @map("emission_factor_ch4")
  emissionFactorN2o     Decimal  @map("emission_factor_n2o")
  emissionFactorTotal   Decimal  @map("emission_factor_total")
  gwpCh4                Int      @default(25) @map("gwp_ch4")
  gwpN2o                Int      @default(298) @map("gwp_n2o")
  emissionFactorSource  String   @map("emission_factor_source")
  sourceSiteRatio       Decimal  @default(1.02) @map("source_site_ratio")
  effectiveDate         DateTime @map("effective_date") @db.Date
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("fuel_type_config")
}

// ---------------------------------------------------------------------------
// LED Lighting Measure Configuration
// ---------------------------------------------------------------------------

/// Lighting technology type config (savings percentages vs LED)
model LightingTechnologyConfig {
  id                        Int      @id @default(autoincrement())
  lightingTypeId            String   @unique @map("lighting_type_id")
  displayName               String   @map("display_name")
  savingsVsLedPct           Decimal  @map("savings_vs_led_pct")
  hidLightingShareAdjustment Decimal @default(0) @map("hid_lighting_share_adjustment")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("lighting_technology_config")
}

// ---------------------------------------------------------------------------
// Assessment Tables
// ---------------------------------------------------------------------------

/// Building assessment with rate classification + EUI + emissions results
model Assessment {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Input fields
  postalCode            String   @map("postal_code") @db.VarChar(10)
  buildingType          String   @map("building_type") @db.VarChar(30)
  buildingSizeSqft      Int      @map("building_size_sqft")
  operatingHours        Int      @map("operating_hours")
  annualElectricityKwh  Int      @map("annual_electricity_kwh")
  annualElectricityCost Decimal? @map("annual_electricity_cost")
  peakDemandKw          Decimal? @map("peak_demand_kw")
  annualGasM3           Decimal? @map("annual_gas_m3")
  primaryFuelType       String?  @map("primary_fuel_type") @db.VarChar(20)
  fuelVolume            Decimal? @map("fuel_volume")

  // LED Measure Inputs
  lightingType          String?  @map("lighting_type") @db.VarChar(30)

  // HVAC Measure Inputs
  fuelSource            String?  @map("fuel_source") @db.VarChar(20)
  hvacAge               String?  @map("hvac_age") @db.VarChar(20)
  annualGasCost         Decimal? @map("annual_gas_cost")
  annualOilLitres       Decimal? @map("annual_oil_litres")
  annualOilCost         Decimal? @map("annual_oil_cost")
  annualPropaneLitres   Decimal? @map("annual_propane_litres")
  annualPropaneCost     Decimal? @map("annual_propane_cost")
  ownershipType         String?  @map("ownership_type") @db.VarChar(10)

  // Rate Classification Results (Section 6.4)
  rateClass             String?  @map("rate_class") @db.VarChar(20)
  rateClassSource       String?  @map("rate_class_source") @db.VarChar(20)
  rateClassConfidence   String?  @map("rate_class_confidence") @db.VarChar(10)
  rateStructure         String?  @map("rate_structure") @db.VarChar(30)
  estimatedPeakKw       Decimal? @map("estimated_peak_kw_for_class")
  classAEligible        Boolean? @map("class_a_eligible")
  effectiveRateTotal    Decimal? @map("effective_rate_total")
  effectiveRateEnergy   Decimal? @map("effective_rate_energy")
  effectiveRateSource   String?  @map("effective_rate_source") @db.VarChar(20)
  demandChargeRate      Decimal? @map("demand_charge_rate")
  demandChargeApplicable Boolean? @map("demand_charge_applicable")

  // EUI Results (Section 7.3)
  completionPath        String?  @map("completion_path") @db.VarChar(10)
  euiElectric           Decimal? @map("eui_electric")
  euiTotal              Decimal? @map("eui_total")
  euiWeatherNormalized  Decimal? @map("eui_weather_normalized")
  euiSourceElectric     Decimal? @map("eui_source_electric")
  euiSourceTotal        Decimal? @map("eui_source_total")
  gasKwhEquivalent      Decimal? @map("gas_kwh_equivalent")
  userEuiVsMedianPct    Decimal? @map("user_eui_vs_median_pct")
  benchmarkComparisonShown Boolean? @map("benchmark_comparison_shown")
  benchmarkCaveatText   String?  @map("benchmark_caveat_text")

  // Regression Results (Section 7.4 — Enhanced Path)
  regressionModelType   String?  @map("regression_model_type") @db.VarChar(10)
  baseloadElectricMonthly Decimal? @map("baseload_electric_monthly")
  betaHeatElectric      Decimal? @map("beta_heat_electric")
  rSquaredElectric      Decimal? @map("r_squared_electric")
  changepointTemp       Decimal? @map("changepoint_temp")
  baseloadElectricAnnual Decimal? @map("baseload_electric_annual")
  weatherDepElectricAnnual Decimal? @map("weather_dep_electric_annual")
  baseloadGasMonthly    Decimal? @map("baseload_gas_monthly")
  betaHeatGas           Decimal? @map("beta_heat_gas")
  rSquaredGas           Decimal? @map("r_squared_gas")
  regressionQualityFlag String?  @map("regression_quality_flag") @db.VarChar(10)

  // Emissions Results (Section 7.5)
  scope1EmissionFactor  Decimal? @map("scope1_emission_factor")
  scope2AverageFactor   Decimal? @map("scope2_average_factor")
  scope2AverageFactorYear Int?   @map("scope2_average_factor_year")
  scope1Tonnes          Decimal? @map("scope1_tonnes")
  scope2Tonnes          Decimal? @map("scope2_tonnes")
  totalEmissionsTonnes  Decimal? @map("total_emissions_tonnes")
  carbonIntensity       Decimal? @map("carbon_intensity")
  scope1CalculatedFromEstimate Boolean? @map("scope1_calculated_from_estimate")

  // Carbon Pricing (Section 7.7 — structural only, null for Ontario)
  carbonCostAnnual      Decimal? @map("carbon_cost_annual")

  // Warnings stored as JSON array
  classificationWarnings Json?   @map("classification_warnings")

  measureResults MeasureResult[]

  @@map("assessments")
}

/// Measure card results linked to an assessment
model MeasureResult {
  id                     String   @id @default(cuid())
  assessmentId           String   @map("assessment_id")
  measureType            String   @map("measure_type") @db.VarChar(30)
  measureName            String   @map("measure_name")

  // Energy savings
  energySavingsKwh       Int      @map("energy_savings_kwh")
  energySavingsDollars   Decimal  @map("energy_savings_dollars")

  // Demand savings (Section 6.5)
  peakReductionApplicable Boolean @map("peak_reduction_applicable")
  peakReductionKw        Decimal? @map("peak_reduction_kw")
  demandSavingsAnnual    Decimal? @map("demand_savings_annual")

  // Total
  totalSavingsAnnual     Decimal  @map("total_savings_annual")

  // 10-year projections
  tenYearConservative    Int?     @map("ten_year_conservative")
  tenYearBaseCase        Int?     @map("ten_year_base_case")
  tenYearHighGrowth      Int?     @map("ten_year_high_growth")

  // Emissions fields (Section 7.6)
  co2ReductionElectricityTonnes Decimal? @map("co2_reduction_electricity_tonnes")
  co2ReductionFuelTonnes Decimal? @map("co2_reduction_fuel_tonnes")
  co2ReductionTotalTonnes Decimal? @map("co2_reduction_total_tonnes")
  co2AddedTonnes         Decimal? @map("co2_added_tonnes")
  co2NetReductionTonnes  Decimal? @map("co2_net_reduction_tonnes")
  emissionFactorUsed     Decimal? @map("emission_factor_used")

  // LED-specific result fields
  lightingEnergyKwh      Int?     @map("lighting_energy_kwh")
  lightingShareUsed      Decimal? @map("lighting_share_used")
  savingsPct             Decimal? @map("savings_pct")
  incentiveEstimate      Decimal? @map("incentive_estimate")
  netCostMidpoint        Decimal? @map("net_cost_midpoint")
  netCostUpper           Decimal? @map("net_cost_upper")
  paybackLower           Decimal? @map("payback_lower")
  paybackUpper           Decimal? @map("payback_upper")
  npvConservative        Decimal? @map("npv_conservative")
  npvBase                Decimal? @map("npv_base")
  npvHigh                Decimal? @map("npv_high")
  confidence             String?  @map("confidence") @db.VarChar(10)
  confidenceNote         String?  @map("confidence_note")
  measureFlags           Json?    @map("measure_flags")

  // HVAC-specific result fields
  hvacScenarioPrimary        String?  @map("hvac_scenario_primary") @db.VarChar(10)
  hvacScenarioAlternative    String?  @map("hvac_scenario_alternative") @db.VarChar(10)
  hvacDataPath               String?  @map("hvac_data_path") @db.VarChar(10)
  hvacElectricityPoolKwh     Decimal? @map("hvac_electricity_pool_kwh")
  hvacGasPoolM3              Decimal? @map("hvac_gas_pool_m3")
  hvacGasPoolEstimated       Boolean? @map("hvac_gas_pool_estimated")
  hvacHeatingElecAddedKwh    Decimal? @map("hvac_heating_elec_added_kwh")
  hvacCoolingKwhSavings      Decimal? @map("hvac_cooling_kwh_savings")
  hvacGasDisplacedM3         Decimal? @map("hvac_gas_displaced_m3")
  hvacDollarSavingsGas       Decimal? @map("hvac_dollar_savings_gas")
  hvacDollarCostElecAdded    Decimal? @map("hvac_dollar_cost_elec_added")
  hvacDollarSavingsCooling   Decimal? @map("hvac_dollar_savings_cooling")
  hvacDollarSavingsNet       Decimal? @map("hvac_dollar_savings_net")
  hvacDemandSavings          Decimal? @map("hvac_demand_savings")
  hvacProjectCostMidpoint    Decimal? @map("hvac_project_cost_midpoint")
  hvacProjectCostUpper       Decimal? @map("hvac_project_cost_upper")
  hvacIncrementalCost        Decimal? @map("hvac_incremental_cost")
  hvacIncentiveLow           Decimal? @map("hvac_incentive_low")
  hvacIncentiveHigh          Decimal? @map("hvac_incentive_high")
  hvacCo2AvoidedScope1       Decimal? @map("hvac_co2_avoided_scope1")
  hvacCo2AddedScope2         Decimal? @map("hvac_co2_added_scope2")
  hvacCo2NetReduction        Decimal? @map("hvac_co2_net_reduction")
  hvacCo2ReductionPct        Decimal? @map("hvac_co2_reduction_pct")
  hvacSeasonalCopUsed        Decimal? @map("hvac_seasonal_cop_used")
  hvacExistingEfficiencyUsed Decimal? @map("hvac_existing_efficiency_used")
  hvacEffectiveGasRateUsed   Decimal? @map("hvac_effective_gas_rate_used")
  hvacCostBasis              String?  @map("hvac_cost_basis")

  // Carbon pricing (structural — null for Ontario)
  carbonSavingsPerMeasure Decimal? @map("carbon_savings_per_measure")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@map("measure_results")
}
